#!/bin/sh
# shellcheck shell=busybox
# shellcheck disable=SC2154  # lease variables come from udhcpc
# =====================================================================
#  Vakuum OS Builder (kod-mini) — BusyBox udhcpc event script
# ---------------------------------------------------------------------
#  udhcpc calls this script with $1 = deconfig|bound|renew|leasefail|nak
#  and passes the lease in the environment: $interface $ip $mask
#  $broadcast $router $dns $domain $lease.
#
#  Settings (optional): /etc/kod/network.conf
#    KOD_FALLBACK_DNS="8.8.8.8"   appended after the DHCP name servers
# =====================================================================

RESOLV_CONF=/etc/resolv.conf
KOD_FALLBACK_DNS="8.8.8.8"
[ -r /etc/kod/network.conf ] && . /etc/kod/network.conf

log() { echo "udhcpc[${interface}]: $*" >&2; }

write_resolv_conf() {
    local tmp="${RESOLV_CONF}.udhcpc.$$" ns seen=" "
    {
        echo "# Generated by udhcpc for ${interface} ($(date))"
        [ -n "${domain}" ] && echo "search ${domain}"
        for ns in ${dns} ${KOD_FALLBACK_DNS}; do
            case "${seen}" in
                *" ${ns} "*) continue ;;
            esac
            seen="${seen}${ns} "
            echo "nameserver ${ns}"
        done
    } >"${tmp}" && mv -f "${tmp}" "${RESOLV_CONF}"
}

case "$1" in
    deconfig)
        ip -4 addr flush dev "${interface}" 2>/dev/null
        ip link set dev "${interface}" up
        ;;

    bound|renew)
        # Re-address only when the lease actually changed (keeps TCP alive).
        if ! ip -4 addr show dev "${interface}" | grep -q "inet ${ip}/${mask:-24} "; then
            ip -4 addr flush dev "${interface}"
            ip -4 addr add "${ip}/${mask:-24}" \
                ${broadcast:+broadcast "${broadcast}"} dev "${interface}"
        fi

        if [ -n "${router}" ]; then
            while ip -4 route del default dev "${interface}" 2>/dev/null; do :; done
            metric=0
            for gw in ${router}; do
                ip -4 route add default via "${gw}" dev "${interface}" \
                    metric "${metric}"
                metric=$((metric + 1))
            done
        fi

        write_resolv_conf
        log "$1: ${ip}/${mask:-24} gw ${router:-none} dns ${dns:-none} lease ${lease:-?}s"
        ;;

    leasefail|nak)
        log "$1: no DHCP lease (yet)"
        ;;

    *)
        ;;
esac

exit 0
