# =====================================================================
#  Vakuum OS Builder (kod-mini) — kernel fragment: aarch64 (preview)
# ---------------------------------------------------------------------
#  Base: arch/arm64/configs/defconfig + kernel-common.config.
#  Target: UEFI virtual machines (QEMU virt, UTM, Parallels, VMware).
#  Note: with CONFIG_MODULES disabled every "=m" driver of the large
#  arm64 defconfig becomes built-in, so this kernel is much bigger
#  than the x86_64 one. A trimmed base config is planned.
# =====================================================================

CONFIG_ARM64=y
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_MMIO=y

# Serial console (QEMU virt: PL011 on ttyAMA0).
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
