# =====================================================================
#  Vakuum OS Builder (kod-mini) — BusyBox fragment
# ---------------------------------------------------------------------
#  Applied on top of "make defconfig" by scripts/build.sh, which also
#  verifies that every line survives "make oldconfig".
# =====================================================================

# --- Build: static binary against musl -------------------------------
CONFIG_STATIC=y
# CONFIG_PIE is not set
CONFIG_LFS=y

# --- Unicode (UTF-8 / Cyrillic in ash, ls, vi, ...) --------------------
CONFIG_UNICODE_SUPPORT=y
CONFIG_FEATURE_CHECK_UNICODE_IN_ENV=y
CONFIG_SUBST_WCHAR=63
CONFIG_LAST_SUPPORTED_WCHAR=12799
CONFIG_UNICODE_WIDE_WCHARS=y

# --- Shells: ash is /bin/sh, GNU Bash is installed separately ----------
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_CTTYHACK=y
CONFIG_SETSID=y

# --- Boot / init helpers ----------------------------------------------
CONFIG_SWITCH_ROOT=y
CONFIG_START_STOP_DAEMON=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
# CONFIG_FEATURE_CALL_TELINIT is not set
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_LOOP=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_UMOUNT=y
CONFIG_FEATURE_UMOUNT_ALL=y
CONFIG_LOSETUP=y
CONFIG_MOUNTPOINT=y
CONFIG_DMESG=y
CONFIG_FEATURE_FANCY_SLEEP=y
CONFIG_FLOAT_DURATION=y

# --- Swap, disks ------------------------------------------------------
CONFIG_MKSWAP=y
CONFIG_SWAPON=y
CONFIG_SWAPOFF=y
CONFIG_FEATURE_SWAPON_PRI=y
CONFIG_FALLOCATE=y
CONFIG_CHATTR=y
CONFIG_BLKID=y
CONFIG_FINDFS=y

# --- Console: fonts and keymaps -------------------------------------
CONFIG_SETFONT=y
CONFIG_LOADFONT=y
CONFIG_FEATURE_LOADFONT_PSF2=y
CONFIG_FEATURE_LOADFONT_RAW=y
CONFIG_LOADKMAP=y
CONFIG_DUMPKMAP=y
CONFIG_KBD_MODE=y
CONFIG_SHOWKEY=y
CONFIG_CHVT=y
CONFIG_CLEAR=y
CONFIG_RESET=y
CONFIG_FEATURE_SEAMLESS_GZ=y

# --- Network --------------------------------------------------------
CONFIG_UDHCPC=y
CONFIG_FEATURE_UDHCPC_ARPING=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_WGET=y
CONFIG_FEATURE_WGET_HTTPS=y
CONFIG_FEATURE_WGET_LONG_OPTIONS=y
CONFIG_FEATURE_WGET_TIMEOUT=y
CONFIG_NSLOOKUP=y
CONFIG_PING=y
# tc does not build against Linux >= 6.8 UAPI headers (CBQ was removed).
# CONFIG_TC is not set

# --- Hashing ----------------------------------------------------------
# The SHA-NI code paths use GNU-assembler-only inline asm; keep the
# portable C implementation (clang / non-x86 friendly).
# CONFIG_SHA1_HWACCEL is not set
# CONFIG_SHA256_HWACCEL is not set
