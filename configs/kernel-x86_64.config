# =====================================================================
#  Vakuum OS Builder (kod-mini) — kernel fragment: x86_64
# ---------------------------------------------------------------------
#  Base: arch/x86/configs/x86_64_defconfig + kernel-common.config.
#  Focus: VirtualBox (BIOS + UEFI), QEMU/KVM and generic PCs.
# =====================================================================

# --- Platform -------------------------------------------------------
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_KERNEL_ZSTD=y
CONFIG_PCI=y
CONFIG_ACPI=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
# 32-bit compat is not needed for a pure musl/LLVM userspace.
# CONFIG_IA32_EMULATION is not set

# --- Firmware: UEFI + BIOS --------------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y

# --- Disks: VirtualBox IDE (PIIX4) / SATA (AHCI) ------------------------
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y

# --- Video ----------------------------------------------------------
# VirtualBox "VBoxVGA"/"VBoxSVGA" -> vboxvideo, "VMSVGA" -> vmwgfx,
# BIOS VESA modes -> vesafb, UEFI GOP -> efifb, QEMU std VGA -> bochs.
CONFIG_DRM_VBOXVIDEO=y
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_BOCHS=y
CONFIG_FB_VESA=y
CONFIG_VGA_CONSOLE=y

# --- Input and serial console ------------------------------------------
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- Network: VirtualBox NIC models -------------------------------------
# Intel PRO/1000 (e1000) is in kernel-common; PCnet-FAST III here.
CONFIG_NET_VENDOR_AMD=y
CONFIG_PCNET32=y

# --- VirtualBox guest integration -------------------------------------
CONFIG_VIRT_DRIVERS=y
CONFIG_VBOXGUEST=y
